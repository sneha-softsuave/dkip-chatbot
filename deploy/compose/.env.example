# Copy to `.env` in this directory and fill in.  cp .env.example .env

# ---- AI provider (the only thing that changes cloud <-> local) --------------
MODEL_PROVIDER=cloud
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_GEN_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIM=3072

# To run fully offline (no key, deterministic answers) set:
#   MODEL_PROVIDER=fake
# To run air-gapped against a local model server (vLLM/Ollama + BGE) set:
#   MODEL_PROVIDER=local  (see docs/RUNNING.md §Air-gap)

# ---- Security ---------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# ---- Reranker ---------------------------------------------------------------
# Smaller default model; swap to BAAI/bge-reranker-v2-m3 for max quality.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
