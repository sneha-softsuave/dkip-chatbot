# Local cross-encoder reranker service (§13.1). CPU torch to keep the image
# demo-friendly; the model downloads on first boot (or bake it for air-gap).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HOME=/models
WORKDIR /app

RUN pip install --upgrade pip && pip install \
        "fastapi==0.115.5" "uvicorn[standard]==0.32.1" "pydantic==2.10.3" \
        "sentence-transformers==3.3.1" \
        "torch==2.5.1" --extra-index-url https://download.pytorch.org/whl/cpu

COPY reranker ./reranker

EXPOSE 8001
CMD ["uvicorn", "reranker.app:app", "--host", "0.0.0.0", "--port", "8001"]
